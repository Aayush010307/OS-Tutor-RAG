# Copy to .env and edit. .env is git-ignored and must never be committed; this example holds placeholders only.

# ollama = a real Ollama server (normal use).  mock = scripted replies, Ollama is never contacted: development and
# tests only, never for students.
LLM_PROVIDER=ollama

# The machine that runs Ollama: this one by default, or another laptop's LAN address, e.g. http://<OLLAMA_HOST>:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120

# socratic (default: diagnose first, then explain the gap and check; the flow the tutor evaluation measures)
# answer_first (optional conversational mode; not yet evaluated, and the React frontend does not handle its stages)
TUTOR_MODE=socratic

# Retrieval: hybrid candidates -> optional cross-encoder rerank -> chunks the LLM sees.
RETRIEVAL_TOP_K=20
RERANKER_ENABLED=false
RERANKER_TOP_K=20
FINAL_CONTEXT_K=5
# RERANK_MIN_SCORE=

# Storage (relative paths are from the repository root)
# VECTOR_STORE_DIR=data/vector_store/qdrant
# LEARNER_DB_PATH=data/learner/learner.json

APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
