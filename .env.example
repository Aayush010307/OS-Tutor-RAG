# Copy to .env and edit. .env is git-ignored and must never be committed; this example holds placeholders only.

# mock = scripted replies, Ollama is never contacted (development, tests).  ollama = a real Ollama server.
LLM_PROVIDER=mock

# The machine that runs Ollama. Any reachable address: http://localhost:11434, or the other laptop's LAN address.
OLLAMA_BASE_URL=http://<OLLAMA_HOST>:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120

# answer_first (conversational tutor, default) | socratic (the original question-first research mode)
TUTOR_MODE=answer_first

# Retrieval: hybrid candidates -> optional cross-encoder rerank -> chunks the LLM sees.
RETRIEVAL_TOP_K=20
RERANKER_ENABLED=false
RERANKER_TOP_K=20
FINAL_CONTEXT_K=5
# RERANK_MIN_SCORE=

# Storage (relative paths are from the repository root)
# VECTOR_STORE_DIR=data/vector_store/qdrant
# LEARNER_DB_PATH=data/learner/learner.json

APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
