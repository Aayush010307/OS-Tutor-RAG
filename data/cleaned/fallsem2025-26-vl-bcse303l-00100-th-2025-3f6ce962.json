    {
      "kind": "slide",
      "number": 27,
      "title": "Synchronization Hardware",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Synchronization Hardware",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Many systems provide hardware support for critical section code",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Uniprocessors – could disable interrupts",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Currently running code would execute without preemption",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Generally too inefficient on multiprocessor systems",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Operating systems using this not broadly scalable",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Modern machines provide special atomic hardware instructions",
          "level": 0
        },
        {
          "type": "code",
          "text": "Atomic = non-interruptable",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Either test memory word and set value",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Or swap contents of two memory words",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 28,
      "title": "TestAndSet Instruction",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "TestAndSet Instruction",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Definition:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "boolean TestAndSet (boolean *target)",
          "level": 0
        },
        {
          "type": "code",
          "text": "          {\n               boolean rv = *target;\n               *target = TRUE;\n               return rv:\n          }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 29,
      "title": "Solution using TestAndSet",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Solution using TestAndSet",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Shared boolean variable lock., initialized to false.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Solution:",
          "level": 0
        },
        {
          "type": "code",
          "text": "           while (true) {\n                     while ( TestAndSet (&lock ))\n                                 ;   /* do nothing\n                               //    critical section\n                     lock = FALSE;\n                               //      remainder section\n           }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 30,
      "title": null,
      "images": null,
      "blocks": [
        {
          "type": "code",
          "text": "boolean waiting[n];\nboolean lock;\nlock = FALSE; waiting[i] = FALSE;",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "do",
          "level": 0
        },
        {
          "type": "code",
          "text": "{\nwaiting[i]=TRUE;\nKey=TRUE;\nWhile(waiting[i] && key)\n    key=TestAndSet(&lock);\nWaiting[i]=FALSE;\n//CS\nj=(i+1)%n;\nWhile((j!=i)&&!waiting[j])\n    j=(j+1)%n;\nIf(j==i)\n    lock=FALSE;\nElse\n    Waiting[j]=FALSE;\n//Remainder section\n} while(TRUE);",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 31,
      "title": "Swap Instruction",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Swap Instruction",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Definition:",
          "level": 0
        },
        {
          "type": "code",
          "text": "         void Swap (boolean *a, boolean *b)\n          {\n                  boolean temp = *a;\n                  *a = *b;",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "*b = temp:",
          "level": 0
        },
        {
          "type": "code",
          "text": "          }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 32,
      "title": "Solution using Swap",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Solution using Swap",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Shared Boolean variable lock initialized to FALSE; Each process has a local Boolean variable key.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Solution:",
          "level": 0
        },
        {
          "type": "code",
          "text": "          while (true)  {\n                    key = TRUE;\n                    while ( key == TRUE)\n                             Swap (&lock, &key );\n                                 //    critical section\n                     lock = FALSE;\n                                //      remainder section\n           }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 33,
      "title": "Semaphore",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Semaphore",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Synchronization tool that does not require busy waiting",
          "level": 0
        },
        {
          "type": "code",
          "text": "Semaphore S – integer variable",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Two standard operations modify S: wait() and signal()",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Originally called P() and V()",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Less complicated",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Can only be accessed via two indivisible (atomic) operations",
          "level": 0
        },
        {
          "type": "code",
          "text": "wait (S) {",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "while S <= 0",
          "level": 0
        },
        {
          "type": "code",
          "text": "                  ; // no-op\n              S--;\n      }\nsignal (S) {\n        S++;\n     }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 34,
      "title": "Semaphore as General Synchronization Tool",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Semaphore as General Synchronization Tool",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Counting semaphore – integer value can range over an unrestricted domain",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Binary semaphore – integer value can range only between 0 \nand 1; can be simpler to implement",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Also known as mutex locks",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Can implement a counting semaphore S as a binary semaphore",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Provides mutual exclusion",
          "level": 0
        },
        {
          "type": "code",
          "text": "Semaphore S;    //  initialized to 1\nwait (S);",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Critical Section",
          "level": 0
        },
        {
          "type": "code",
          "text": "     signal (S);",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 35,
      "title": "Semaphore Implementation",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Semaphore Implementation",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Must guarantee that no two processes can execute wait () and signal () on the same semaphore at the same time",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Thus, implementation becomes the critical section problem where the wait and signal code are placed in the crtical section.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Could now have busy waiting in critical section implementation",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "But implementation code is short",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Little busy waiting if critical section rarely occupied",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Note that applications may spend lots of time in critical sections and therefore this is not a good solution.",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 36,
      "title": "Semaphore Implementation with no Busy waiting (spin lock)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Semaphore Implementation with no Busy waiting (spin lock)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "With each semaphore there is an associated waiting queue. Each entry in a waiting queue has two data items:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "value (of type integer)",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pointer to next record in the list",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Two operations:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "block – place the process invoking the operation on the appropriate waiting queue.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "wakeup – remove one of processes in the waiting queue and place it in the ready queue.",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 37,
      "title": "Semaphore Implementation",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Semaphore Implementation",
          "level": 1
        },
        {
          "type": "code",
          "text": "typedef struct\n{\nint value;\nstruct process * list;\n}semaphore;",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 38,
      "title": "Semaphore Implementation with no Busy waiting (Cont.)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Semaphore Implementation with no Busy waiting (Cont.)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Implementation of wait:",
          "level": 0
        },
        {
          "type": "code",
          "text": "                        wait (semaphore *S){\n                              S->value--;\n                              if (S->value < 0) {",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "add this process to S->list",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "block(); }",
          "level": 0
        },
        {
          "type": "code",
          "text": "                         }",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Implementation of signal:",
          "level": 0
        },
        {
          "type": "code",
          "text": "                        Signal (semaphore *S){\n                                S-> value++;\n                                  if (S->value > 0) {",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "remove a process P from the waiting queue",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "wakeup(P); }",
          "level": 0
        },
        {
          "type": "code",
          "text": "                        }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 39,
      "title": null,
      "images": null,
      "blocks": []
    },
    {
      "kind": "slide",
      "number": 40,
      "title": "Deadlock and Starvation",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Deadlock and Starvation",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Deadlock – two or more processes are waiting indefinitely for an event that can be caused by only one of the waiting processes",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Let S and Q be two semaphores initialized to 1",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "P0 P1",
          "level": 0
        },
        {
          "type": "code",
          "text": "            wait (S);                                          wait (Q);\n              wait (Q);                                          wait (S);",
          "level": 0
        },
        {
          "type": "list_item",
          "text": ". .",
          "level": 0
        },
        {
          "type": "list_item",
          "text": ". .",
          "level": 0
        },
        {
          "type": "list_item",
          "text": ". .",
          "level": 0
        },
        {
          "type": "code",
          "text": "                signal  (S);                                            signal (Q);\n                signal (Q);                                            signal (S);",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Starvation – indefinite blocking. A process may never be removed from the semaphore queue in which it is suspended.",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 41,
      "title": "Classical Problems of Synchronization",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Classical Problems of Synchronization",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Bounded-Buffer Problem",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Readers and Writers Problem",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Dining-Philosophers Problem",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 42,
      "title": "Bounded-Buffer Problem",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Bounded-Buffer Problem",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "N buffers, each can hold one item",
          "level": 0
        },
        {
          "type": "code",
          "text": "Semaphore mutex initialized to the value 1\nSemaphore full initialized to the value 0",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Semaphore empty initialized to the value N.",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 43,
      "title": "Bounded Buffer Problem (Cont.)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Bounded Buffer Problem (Cont.)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "The structure of the producer process",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Mutex=1, full=0,empty=N",
          "level": 0
        },
        {
          "type": "code",
          "text": "           while (true)  {\n                         //   produce an item\n                   wait (empty);\n                   wait (mutex);\n                         //  add the item to the  buffer\n                    signal (mutex);\n                    signal (full);\n           }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 44,
      "title": "Bounded Buffer Problem (Cont.)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Bounded Buffer Problem (Cont.)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "The structure of the consumer process",
          "level": 0
        },
        {
          "type": "code",
          "text": "           while (true) {\n                    wait (full);\n                    wait (mutex);\n                             //  remove an item from  buffer\n                    signal (mutex);\n                    signal (empty);\n                            //  consume the removed item\n           }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 45,
      "title": "Readers-Writers Problem",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Readers-Writers Problem",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "A data set is shared among a number of concurrent processes",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Readers – only read the data set; they do not perform any updates",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Writers – can both read and write.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Problem – allow multiple readers to read at the same time. Only one single writer can access the shared data at the same time.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Shared Data",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Data set",
          "level": 0
        },
        {
          "type": "code",
          "text": "Semaphore mutex initialized to 1.\nSemaphore wrt initialized to 1.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Integer readcount initialized to 0.",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 46,
      "title": "Readers-Writers Problem (Cont.)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Readers-Writers Problem (Cont.)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "The structure of a writer process",
          "level": 0
        },
        {
          "type": "code",
          "text": "              while (true) {\n                        wait (wrt) ;\n                             //    writing is performed\n                        signal (wrt) ;\n             }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 47,
      "title": "Readers-Writers Problem (Cont.)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Readers-Writers Problem (Cont.)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "The structure of a reader process",
          "level": 0
        },
        {
          "type": "code",
          "text": "              while (true) {\n                       wait (mutex) ;\n                       readcount ++ ;\n                       if (readercount == 1)  wait (wrt) ;",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "signal (mutex)",
          "level": 0
        },
        {
          "type": "code",
          "text": "                               // reading is performed\n                        wait (mutex) ;\n                        readcount  - - ;\n                        if (redacount  == 0)  signal (wrt) ;\n                        signal (mutex) ;\n              }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 48,
      "title": "Dining-Philosophers Problem",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Dining-Philosophers Problem",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Shared data",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Bowl of rice (data set)",
          "level": 0
        },
        {
          "type": "code",
          "text": "Semaphore chopstick [5] initialized to 1",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 49,
      "title": "Philo i",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Philo i",
          "level": 1
        },
        {
          "type": "code",
          "text": "Wait(chopstick[0]); //0\nWait(chopstick[1]); //0",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Eat",
          "level": 0
        },
        {
          "type": "code",
          "text": "Signal(chopstick[0]);\nSignal(chopstick[1]);",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 50,
      "title": "Dining-Philosophers Problem (Cont.)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Dining-Philosophers Problem (Cont.)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "The structure of Philosopher i:",
          "level": 0
        },
        {
          "type": "code",
          "text": "While (true)  {\n          wait ( chopstick[i] );\n         wait ( chopStick[ (i + 1) % 5] );\n                 //  eat\n         signal ( chopstick[i] );\n         signal (chopstick[ (i + 1) % 5] );\n                 //  think\n}",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 51,
      "title": "Problems with Semaphores",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Problems with Semaphores",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Correct use of semaphore operations:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "signal (mutex) …. wait (mutex)",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "wait (mutex) … wait (mutex)",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Omitting of wait (mutex) or signal (mutex) (or both)",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 52,
      "title": "Monitors",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Monitors",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "A high-level abstraction that provides a convenient and effective mechanism for process synchronization",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Only one process may be active within the monitor at a time",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "monitor monitor-name",
          "level": 0
        },
        {
          "type": "code",
          "text": "{\n    // shared variable declarations",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "procedure P1 (…) { …. }",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "…",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "procedure Pn (…) {……}",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Initialization code ( ….) { … }",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "…",
          "level": 0
        },
        {
          "type": "code",
          "text": "    }\n}",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 53,
      "title": "Schematic view of a Monitor",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Schematic view of a Monitor",
          "level": 1
        }
      ]
    },
    {
      "kind": "slide",
      "number": 54,
      "title": "Condition Variables",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Condition Variables",
          "level": 1
        },
        {
          "type": "code",
          "text": "condition x, y;",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Two operations on a condition variable:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "x.wait () – a process that invokes the operation is",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "suspended.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "x.signal () – resumes one of processes (if any) that",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "invoked x.wait ()",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Two possibilities for signal",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "1. Signal and wait: P either waits until Q leaves the monitoror waits for another condition",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "2. Signal and continue: Q either waits until P leaves the monitor or waits for another condition.",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 55,
      "title": "Monitor with Condition Variables",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Monitor with Condition Variables",
          "level": 1
        }
      ]
    },
    {
      "kind": "slide",
      "number": 56,
      "title": "Producer - Consumer",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Producer - Consumer",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "monitor PC",
          "level": 0
        },
        {
          "type": "code",
          "text": "   {\nint slots=0;\ncondition full, empty;\nVoid producer()\n{\nwhile(slots==N)    empty.wait();\nslots++;\nfull.signal();\n}\nVoid consumer()\n{\nWhile(slots==0) full.wait();\nslots--;\nempty.signal();\n}",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 57,
      "title": "Solution to Dining Philosophers",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Solution to Dining Philosophers",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "monitor DP",
          "level": 0
        },
        {
          "type": "code",
          "text": "   {\n    enum { THINKING; HUNGRY, EATING) state [5] ;\n    condition self [5];\n    void pickup (int i) {\n           state[i] = HUNGRY;\n           test(i);\n           if (state[i] != EATING) self [i].wait();\n    }\n       void putdown (int i) {\n           state[i] = THINKING;\n                   // test left and right neighbors\n            test((i + 4) % 5);\n            test((i + 1) % 5);\n        }",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 58,
      "title": "Solution to Dining Philosophers (cont)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Solution to Dining Philosophers (cont)",
          "level": 1
        },
        {
          "type": "code",
          "text": "    void test (int i) {\n            if ( (state[(i + 4) % 5] != EATING) &&",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "(state[i] == HUNGRY) &&",
          "level": 0
        },
        {
          "type": "code",
          "text": "            (state[(i + 1) % 5] != EATING) ) {\n                 state[i] = EATING ;\n            self[i].signal () ;\n             }\n     }\n       initialization_code() {\n           for (int i = 0; i < 5; i++)\n           state[i] = THINKING;\n    }\n}",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 59,
      "title": "Solution to Dining Philosophers (cont)",
      "images": null,
      "blocks": [
        {
          "type": "heading",
          "text": "Solution to Dining Philosophers (cont)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Each philosopher I invokes the operations pickup()",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "and putdown() in the following sequence:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "dp.pickup (i)",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "EAT",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "dp.putdown (i)",
          "level": 0
        }
      ]
    }
  ]
}
