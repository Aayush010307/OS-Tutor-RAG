        },
        {
          "type": "list_item",
          "text": "waiting_B",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "pthread_cond_wait() – When the junction is occupied.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_signal() – Notify the next waiting train.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Alternation/fairness logic should be implemented to reduce starvation.",
          "level": 0
        }
      ]
    },
