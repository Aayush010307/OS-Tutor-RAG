      "blocks": [
        {
          "type": "heading",
          "text": "7. Database Connection Pool",
          "level": 1
        },
        {
          "type": "heading",
          "text": "Problem",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "A system has 3 database connections shared among 6 client threads.",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Each client must acquire one available connection, perform its operation, and release the connection.",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Input",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "Number of database connections: 3\nNumber of clients: 6",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Output",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "Client 1 acquired Connection 1\nClient 2 acquired Connection 2\nClient 3 acquired Connection 3",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Client 4 waiting for connection\nClient 5 waiting for connection\nClient 6 waiting for connection",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Client 2 released Connection 2\nClient 4 acquired Connection 2",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Client 1 released Connection 1\nClient 5 acquired Connection 1",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Students must use",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "pthread_create() – One thread for each client.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_mutex_t – Protect the connection pool.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_t – For clients waiting for a connection.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Shared data structure:",
          "level": 0
        },
        {
          "type": "code",
          "text": "int connection_status[3];",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "For example:",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "0 → Available\n1 → Busy",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_wait() – When no connection is available.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_signal() – When a connection is released.",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Important",
          "level": 1
        }
      ]
    },
    {
      "kind": "page",
      "number": 8,
      "title": null,
      "images": 0,
      "blocks": [
        {
          "type": "paragraph",
          "text": "Students must ensure that the same connection is not assigned to two clients simultaneously.",
          "level": 0
        },
        {
          "type": "heading",
          "text": "8. Computer Lab Allocation with Priority",
          "level": 1
        },
        {
          "type": "heading",
          "text": "Problem",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "A computer lab has 3 computers shared by students and faculty.",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Faculty members should receive priority over waiting students.",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Input",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "Number of computers: 3\nNumber of users: 6",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "User Type\nU1 Student\nU2 Faculty\nU3 Student\nU4 Faculty\nU5 Student\nU6 Student",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Output",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "U2 (Faculty) assigned Computer 1\nU4 (Faculty) assigned Computer 2\nU1 (Student) assigned Computer 3",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "U3 waiting\nU5 waiting\nU6 waiting",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "U2 released Computer 1\nU3 assigned Computer 1",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "U4 released Computer 2\nU5 assigned Computer 2",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Students must use",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "pthread_create() – One thread per user.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_mutex_t – Protect computer allocation.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Two condition variables:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "faculty_cond",
          "level": 1
        },
