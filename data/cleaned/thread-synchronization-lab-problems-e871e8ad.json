        },
        {
          "type": "list_item",
          "text": "pthread_create() – One thread for each train.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_mutex_t – Protect the railway junction.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Two condition variables:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "trackA_cond",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "trackB_cond",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Shared variables:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "junction_busy",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "last_track",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "waiting_A",
