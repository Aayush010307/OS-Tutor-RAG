        },
        {
          "type": "paragraph",
          "text": "Train Track\nT1 A\nT2 B\nT3 A\nT4 B\nT5 A",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Output",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "T1 from Track A entered the junction",
