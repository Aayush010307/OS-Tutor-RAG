        {
          "type": "heading",
          "text": "9. Traffic Intersection Synchronization",
          "level": 1
        },
        {
          "type": "heading",
          "text": "Problem",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "Vehicles arrive from North, South, East, and West.",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Rules:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "North and South vehicles may pass simultaneously.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "East and West vehicles may pass simultaneously.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "North/South traffic cannot pass together with East/West traffic.",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Input",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "Number of vehicles: 6",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Vehicle Direction\nV1 North\nV2 South\nV3 East\nV4 West\nV5 North\nV6 East",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Output",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "V1 entered from North\nV2 entered from South",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "V3 waiting from East\nV4 waiting from West",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "V1 exited\nV2 exited",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "V3 entered from East\nV4 entered from West",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "V3 exited\nV4 exited",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "V5 entered from North",
          "level": 0
        }
      ]
    },
    {
      "kind": "page",
      "number": 10,
      "title": null,
      "images": 0,
      "blocks": [
        {
          "type": "heading",
          "text": "Students must use",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "pthread_create() – One thread per vehicle.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_mutex_t – Protect intersection state.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "At least two condition variables:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "north_south_cond",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "east_west_cond",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Shared variables:",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "ns_count",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "ew_count",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "pthread_cond_wait() – When conflicting traffic is using the intersection.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_broadcast() – When an entire direction group finishes.",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "This is one of the more challenging questions because students must identify compatible and conflicting threads.",
          "level": 0
        },
        {
          "type": "heading",
          "text": "10. Shared Resource Pool",
          "level": 1
        },
        {
          "type": "heading",
          "text": "Problem",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "A system contains 3 identical resources shared among 7 threads.",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Each thread must:",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "1. Request a resource.",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "2. Use the resource.",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "3. Release the resource.",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Input",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "Number of resources: 3\nNumber of threads: 7",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Sample Output",
          "level": 1
        },
        {
          "type": "paragraph",
          "text": "T1 acquired Resource 1\nT2 acquired Resource 2\nT3 acquired Resource 3",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "T4 waiting\nT5 waiting\nT6 waiting\nT7 waiting",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "T2 released Resource 2\nT4 acquired Resource 2",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "T1 released Resource 1",
          "level": 0
        }
      ]
    },
    {
      "kind": "page",
      "number": 11,
      "title": null,
      "images": 0,
      "blocks": [
        {
          "type": "paragraph",
          "text": "T5 acquired Resource 1",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "T3 released Resource 3\nT6 acquired Resource 3",
          "level": 0
        },
        {
          "type": "heading",
          "text": "Students must use",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "pthread_create() – Create 7 worker threads.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_join() – Wait for completion.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_mutex_t – Protect the resource pool.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_t – Wait for resource availability.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Shared array:",
          "level": 0
        },
        {
          "type": "code",
          "text": "int resource[3];",
          "level": 0
        },
        {
          "type": "paragraph",
          "text": "Example:",
          "level": 0
        },
        {
          "type": "code",
          "text": "resource[i] = 0 → Free\nresource[i] = 1 → Allocated",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_wait() – If all resources are busy.",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "pthread_cond_signal() – When a resource is released.",
          "level": 0
        }
      ]
    }
  ]
