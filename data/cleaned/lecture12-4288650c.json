    {
      "kind": "page",
      "number": 9,
      "title": "Threads with shared data: what happens?",
      "images": 14,
      "blocks": [
        {
          "type": "heading",
          "text": "Threads with shared data: what happens?",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "What do we expect? Two threads, each increments counter by 10^7, so 2X10^7",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Sometimes, a lower value. Why?",
          "level": 0
        }
      ]
    },
    {
      "kind": "page",
      "number": 10,
      "title": "What is happening?",
      "images": 14,
      "blocks": [
        {
          "type": "heading",
          "text": "What is happening?",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Assembly code of",
          "level": 0
        },
        {
          "type": "code",
          "text": "counter = counter + 1",
          "level": 0
        }
      ]
