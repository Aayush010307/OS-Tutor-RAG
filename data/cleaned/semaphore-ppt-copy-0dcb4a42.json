      "number": 6,
      "title": "Incorrect solution with deadlock",
      "images": 0,
      "blocks": [
        {
          "type": "heading",
          "text": "Incorrect solution with deadlock",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "What if lock is acquired before signaling?",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Waiting thread sleeps with mutex and the signaling thread can never wake it up",
          "level": 0
        }
      ]
