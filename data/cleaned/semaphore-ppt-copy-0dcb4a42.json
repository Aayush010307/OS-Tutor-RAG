    {
      "kind": "slide",
      "number": 2,
      "title": "What is a semaphore?",
      "images": 0,
      "blocks": [
        {
          "type": "heading",
          "text": "What is a semaphore?",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Synchronization primitive like condition variables",
          "level": 0
        },
        {
          "type": "code",
          "text": "Semaphore is a variable with an underlying counter",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Two functions on a semaphore variable",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Up/post increments the counter",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Down/wait decrements the counter and blocks the calling thread if the resulting value is negative",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "A semaphore with init value 1 acts as a simple lock (binary semaphore = mutex)",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 3,
      "title": "Semaphores for ordering",
      "images": 0,
      "blocks": [
        {
          "type": "heading",
          "text": "Semaphores for ordering",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Can be used to set order of execution between threads like CV",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "Example: parent waiting for child (init = 0)",
          "level": 0
        }
      ]
    },
    {
      "kind": "slide",
      "number": 4,
      "title": "Example: Producer/Consumer (1)",
      "images": 0,
      "blocks": [
        {
          "type": "heading",
          "text": "Example: Producer/Consumer (1)",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "Need two semaphores for signaling",
          "level": 0
        },
        {
          "type": "list_item",
          "text": "One to track empty slots, and make producer wait if no more empty slots",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "One to track full slots, and make consumer wait if no more full slots",
          "level": 1
        },
        {
          "type": "list_item",
          "text": "One semaphore to act as mutex for buffer",
          "level": 0
        }
      ]
    },
