          "para_break": true,
          "top": 0.257,
          "bottom": 0.329,
          "x0": 79.2,
          "cw": 11.21
        },
        {
          "text": "programs",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.319,
          "bottom": 0.386,
          "x0": 106.2,
          "cw": 15.42
        },
        {
          "text": "• Example: in a multi-threaded web server, one",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.383,
          "bottom": 0.455,
          "x0": 79.2,
          "cw": 11.21
        },
        {
          "text": "thread accepts requests from the network and",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.445,
          "bottom": 0.511,
          "x0": 106.2,
          "cw": 13.7
        },
        {
          "text": "puts them in a queue. Worker threads get",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.501,
          "bottom": 0.568,
          "x0": 106.2,
          "cw": 13.56
        },
        {
          "text": "requests from this queue and process them.",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.558,
          "bottom": 0.624,
          "x0": 106.2,
          "cw": 13.62
        },
        {
          "text": "• Setup: one or more producer threads, one or",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.621,
          "bottom": 0.693,
          "x0": 79.2,
          "cw": 11.21
        },
        {
          "text": "more consumer threads, a shared buffer of",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.683,
          "bottom": 0.75,
          "x0": 106.2,
          "cw": 13.59
        },
        {
          "text": "bounded size",
          "kind": "text",
          "level": 0,
