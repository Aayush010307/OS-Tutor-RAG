    {
      "kind": "page",
      "number": 11,
      "title": "Race conditions and synchronization",
      "images": 14,
      "lines": [
        {
          "text": "Race conditions and synchronization",
          "kind": "heading",
          "level": 1,
          "para_break": true,
          "top": 0.127,
          "bottom": 0.21,
          "x0": 101.1,
          "cw": 16.83
        },
        {
          "text": "• What just happened is called a race condition",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.209,
          "bottom": 0.277,
          "x0": 79.2,
          "cw": 10.5
        },
        {
