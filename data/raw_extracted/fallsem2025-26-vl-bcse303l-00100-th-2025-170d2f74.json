    {
      "kind": "slide",
      "number": 35,
      "title": "Linux Threads",
      "images": 0,
      "lines": [
        {
          "text": "Linux Threads",
          "kind": "heading",
          "level": 1,
          "para_break": true
        },
        {
          "text": "Linux refers to them as tasks rather than threads",
          "kind": "bullet",
          "level": 0,
          "para_break": true
        },
        {
          "text": "Thread creation is done through clone() system call",
          "kind": "bullet",
          "level": 0,
          "para_break": true
        },
        {
          "text": "clone() allows a child task to share the address space of the parent task (process)",
          "kind": "bullet",
          "level": 0,
          "para_break": true
        },
        {
          "text": "struct task_struct points to process data structures (shared or unique)",
          "kind": "code",
          "level": 0,
          "para_break": false
        }
      ]
    },
    {
      "kind": "slide",
      "number": 36,
      "title": "Linux Threads",
      "images": 1,
      "lines": [
        {
          "text": "Linux Threads",
          "kind": "heading",
          "level": 1,
          "para_break": true
        },
        {
          "text": "fork() and clone() system calls",
          "kind": "bullet",
          "level": 0,
          "para_break": true
        },
        {
          "text": "Doesn’t distinguish between process and thread",
          "kind": "bullet",
          "level": 0,
          "para_break": true
        },
        {
          "text": "Uses term task rather than thread",
          "kind": "bullet",
          "level": 1,
          "para_break": true
        },
        {
          "text": "clone() takes options to determine sharing on process create",
          "kind": "bullet",
          "level": 0,
          "para_break": true
        },
        {
          "text": "struct task_struct points to process data structures (shared or unique)",
          "kind": "code",
          "level": 0,
          "para_break": false
        }
      ]
    }
