          "top": 0.465,
          "bottom": 0.512,
          "x0": 75.2,
          "cw": 9.84
        },
        {
          "text": "• Threads execute independently from parent after",
          "kind": "text",
          "level": 0,
          "para_break": false,
          "top": 0.514,
          "bottom": 0.553,
          "x0": 90.1,
          "cw": 6.93
        },
        {
